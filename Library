function UILibrary:randomName(len)
local chars="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local out={}
for i=1,len do
local n=math.random(1,#chars)
out[i]=chars:sub(n,n)
end
return table.concat(out)
end
function UILibrary:New(name,keybind,toggleButton)
local self=setmetatable({},{ __index=UILibrary })
self.Name=name or "System"
self.Keybind=keybind or Enum.KeyCode.RightControl
