tabButton.TextSize=13
tabButton.Font=Enum.Font.GothamMedium
tabButton.AutoButtonColor=false
tabButton.ZIndex=9e99
Instance.new("UICorner",tabButton).CornerRadius=UDim.new(0,8)
local tabStr=Instance.new("UIStroke",tabButton)
tabStr.Name=self:randomName(6)
tabStr.Thickness=1
tabStr.Color=THEME.Stroke
tabStr.Transparency=0.0
tabStr.ZIndex=9e99
local bar=Instance.new("Frame",tabButton)
bar.Name=self:randomName(6)
bar.Size=UDim2.new(0,3,0.45,0)
bar.Position=UDim2.new(0,0,0.275,0)
bar.BackgroundColor3=THEME.Accent
bar.BorderSizePixel=0
bar.Visible=false
bar.ZIndex=9e99
Instance.new("UICorner",bar).CornerRadius=UDim.new(0,2)
local tabFrame=Instance.new("Frame",self.RightPanel)
tabFrame.Name=self:randomName(8)
tabFrame.Size=UDim2.new(1,0,1,0)
tabFrame.BackgroundTransparency=1
tabFrame.Visible=false
tabFrame.ZIndex=9e99
tab.Button=tabButton
tab.ActiveBar=bar
tab.Stroke=tabStr
tab.Frame=tabFrame
table.insert(self.TabList,tab)
self.TabFrames[name]=tab
if #self.TabList==1 then self:SelectTab(name) end
tabButton.MouseButton1Click:Connect(function() self:SelectTab(name) end)
tabButton.MouseEnter:Connect(function()
if self.CurrentTab ~=tab then
TweenService:Create(tabButton,TWEEN_FAST,{ BackgroundColor3=THEME.Card }):Play()
end
end)
tabButton.MouseLeave:Connect(function()
if self.CurrentTab ~=tab then
TweenService:Create(tabButton,TWEEN_FAST,{ BackgroundColor3=THEME.BG }):Play()
end
end)
return tab
end
function UILibrary:SelectTab(name)
for _,tab in ipairs(self.TabList) do
if tab.Frame     then tab.Frame.Visible=false end
if tab.Button    then
TweenService:Create(tab.Button,TWEEN_FAST,{ BackgroundColor3=THEME.BG }):Play()
tab.Button.TextColor3=THEME.TextOff
end
if tab.Stroke    then tab.Stroke.Color=THEME.Stroke; tab.Stroke.Transparency=0.0 end
if tab.ActiveBar then tab.ActiveBar.Visible=false end
end
local sel=self.TabFrames[name]
if sel then
sel.Frame.Visible=true
TweenService:Create(sel.Button,TWEEN_FAST,{ BackgroundColor3=THEME.TabActive }):Play()
sel.Button.TextColor3=THEME.Accent
if sel.Stroke    then sel.Stroke.Color=THEME.StrokeLight; sel.Stroke.Transparency=0.3 end
if sel.ActiveBar then sel.ActiveBar.Visible=true end
self.CurrentTab=sel
end
end
